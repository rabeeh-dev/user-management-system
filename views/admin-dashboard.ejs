<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard</title>
    <style>
        /* Simple Styling */
        body { font-family: sans-serif; background-color: #242424; padding: 20px; }
        .header { display: flex; justify-content: space-between; align-items: center; background: rgb(106, 105, 105); padding: 15px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); color: white;}
        h1 { margin: 0; color: #333; }
        .logout-btn { background: #dc3545; color: white; text-decoration: none; padding: 8px 15px; border-radius: 4px; }
        
        /* Search Bar */
        .search-container { margin: 20px 0; display: flex; gap: 10px;}
        input[type="text"] { padding: 8px; width: 300px; border: 1px solid #ccc; border-radius: 4px; }
        button { padding: 8px 15px; background: #eaebec; color: rgb(14, 13, 13); border: none; border-radius: 4px; cursor: pointer; }
        
        /* Table */
        table { width: 100%; border-collapse: collapse; background: rgb(74, 74, 74); border-radius: 8px; overflow: hidden; box-shadow: 0 2px 5px rgba(0,0,0,0.1); color: white;}
        th, td { padding: 12px 15px; text-align: left; border-bottom: 1px solid #ddd; }
        th { background-color: #2c2c2d; color: white; }
        tr:hover { background-color: #f1f1f1;color: black; }
        
        /* Action Buttons */
        .btn-edit { background: #ffc107; color: black; padding: 5px 10px; text-decoration: none; border-radius: 3px; font-size: 0.9em; }
        .btn-delete { background: #dc3545; color: white; padding: 5px 10px; text-decoration: none; border-radius: 3px; font-size: 0.9em; margin-left: 5px; }
    </style>
</head>
<body>

    <div class="header">
        <h1 style="color: white;">Dashboard</h1>
        <div>
            <span>Welcome, <strong><%= adminName %></strong></span>
            <a href="/admin/logout" class="logout-btn" style="margin-left: 15px;">Logout</a>
        </div>
    </div>

    <div class="search-container">
        <form action="/admin/dashboard" method="GET">
            <input type="text" name="search" placeholder="Search by name or email...">
            <button type="submit">Search</button>
            <!-- <a href="/admin/dashboard" style="margin-left: 10px; text-decoration: none; color: #555; align-self: center;">Reset</a> -->
        </form>
    </div>

    <table>
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (users.length > 0) { %>
                <% users.forEach(user => { %>
                    <tr>
                        <td><%= user.username %></td>
                        <td><%= user.email %></td>
                        <td>
                            <span style="background: <%= user.role === 'admin' ? '#d4edda' : '#e2e3e5' %>; padding: 3px 8px; border-radius: 10px; font-size: 0.8em;">
                                <%= user.role %>
                            </span>
                        </td>
                        <td>
                            <a href="/admin/edit-user/<%= user._id %>" class="btn-edit">Edit</a>
                            
                            <a href="/admin/delete-user/<%= user._id %>" class="btn-delete" 
                               onclick="return confirm('Are you sure you want to delete <%= user.username %>?')">
                               Delete
                            </a>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="4" style="text-align: center;">No users found.</td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <div style="margin-top: 20px;">
        <a href="/admin/create-user" style="background: #3b3c3c; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px;">+ Add New User</a>
    </div>

</body>
</html>